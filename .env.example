LASTFM_API_KEY=your_api_key_here
LASTFM_USERNAME=your_lastfm_username
LASTFM_BASE_URL=http://ws.audioscrobbler.com/2.0/
APP_TIMEZONE=America/New_York
OUTPUT_DIR=reports
LOW_HISTORY_THRESHOLD=2
RECOMMENDATION_LIMIT=4
FRIDAY_RUN_HOUR=19
FRIDAY_RUN_MINUTE=0
AOTY_BASE_URL=https://www.albumoftheyear.org
# AOTY is behind Cloudflare Turnstile; the fallback drives a real (headed) Chrome
# via undetected-chromedriver. Headless is currently detected and blocked.
AOTY_BROWSER_ENABLED=true
AOTY_BROWSER_HEADLESS=false
AOTY_BROWSER_TIMEOUT_SECONDS=40
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=LLaMA3.2:1B
LLM_TIMEOUT_SECONDS=60
LISTENING_HISTORY_PATH=.listening_history.json
LISTENING_HISTORY_REFRESH_DAYS=30
RELEASE_HIGHLIGHT_MIN_ARTIST_LISTENS=3

EMAIL_ENABLED=false
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=recipient@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
